{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantumBrowser",
  "version": "0.0.1",
  "identifier": "com.quantum.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "shell",
        "title": "QuantumBrowser",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "QuantumBrowser",
    "copyright": "© 2026 QuantumBrowser Projesi — MIT Lisansı",
    "shortDescription": "Arc tarzı, gizlilik saygılı Windows tarayıcı",
    "longDescription": "QuantumBrowser — Microsoft WebView2 (Chromium) tabanlı, Rust çekirdekli, Arc tarzı ferah arayüze sahip, reklam ve izleyici engelleyicili, yerleşik gizlilik özellikleri olan masaüstü tarayıcı.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
